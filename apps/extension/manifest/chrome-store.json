{
  "manifest_version": 3,
  "name": "Open Resume Toolkit",
  "version": "0.3.0",
  "description": "Capture visible page text and its link with a two-click box controlled entirely from the Open Resume Toolkit desktop overlay.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["scripting", "nativeMessaging", "alarms"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  },
  "host_permissions": ["http://*/*", "https://*/*"]
}
