{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BeginImportRequest",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "payload": {
      "$ref": "#/$defs/BeginImportPayload"
    },
    "requestId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "payload"
  ],
  "$defs": {
    "BeginImportPayload": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "additionalProperties": false
    }
  }
}
