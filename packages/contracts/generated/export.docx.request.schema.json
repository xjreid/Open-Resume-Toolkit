{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StyledExportRequest",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "payload": {
      "$ref": "#/$defs/StyledExportPayload"
    },
    "requestId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "payload"
  ],
  "$defs": {
    "DocumentStyle": {
      "description": "Reviewed, bundled presentation choices. This is never a path or template source.\nPlain remains the default for requests created before style selection existed.",
      "type": "string",
      "enum": [
        "plain",
        "technical",
        "professional",
        "modern"
      ]
    },
    "ExportSource": {
      "type": "string",
      "enum": [
        "saved_draft",
        "published_snapshot"
      ]
    },
    "StyledExportPayload": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "format": "int64"
        },
        "source": {
          "$ref": "#/$defs/ExportSource"
        },
        "style": {
          "$ref": "#/$defs/DocumentStyle",
          "default": "plain"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "expectedRevision"
      ]
    }
  }
}
